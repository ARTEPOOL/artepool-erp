{
  "name": "artepool-erp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm i18n:check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "i18n:check": "tsx packages/i18n/src/check-keys-cli.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:setup": "tsx tools/dev-db/src/cli.ts",
    "db:migrate": "tsx tools/migrate/src/cli.ts up",
    "db:status": "tsx tools/migrate/src/cli.ts status",
    "db:new": "tsx tools/migrate/src/cli.ts new",
    "db:codegen": "tsx tools/dev-db/src/codegen.ts",
    "db:codegen:check": "tsx tools/dev-db/src/codegen.ts --check",
    "audit:verify": "tsx tools/audit-verify/src/cli.ts",
    "demo:audit-tamper": "tsx tools/audit-verify/src/demo-tamper.ts",
    "dev:server": "tsx watch apps/server/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
