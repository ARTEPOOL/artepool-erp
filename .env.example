# Local development settings for ARTÉPOOL ERP.
# Copy this file to .env and change every password. NEVER commit .env.
# These values are for a development PC only; production uses the installer (M6).

PGHOST=localhost
PGPORT=5432

# PostgreSQL superuser: used only by `pnpm db:setup`, the tests and the tamper demo.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me

# Database names (must end in _dev and _test).
ARTEPOOL_DB=artepool_dev
ARTEPOOL_TEST_DB=artepool_test

# Passwords for the ARTÉPOOL database roles (development only).
ARTEPOOL_MIGRATOR_PASSWORD=change-me-migrator
ARTEPOOL_API_PASSWORD=change-me-api
ARTEPOOL_BACKUP_PASSWORD=change-me-backup
ARTEPOOL_MAINT_PASSWORD=change-me-maint

# API server (development).
SERVER_HOST=127.0.0.1
SERVER_PORT=3100
LOG_LEVEL=info
