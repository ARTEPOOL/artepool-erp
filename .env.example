# Local development settings for ARTÉPOOL ERP.
# Copy this file to .env and change every password. NEVER commit .env.
# These values are for a development PC only; production uses the installer (M6).

PGHOST=localhost
PGPORT=5432

# PostgreSQL superuser: used only by `pnpm db:setup`, the tests and the tamper demo.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me

# Database names (must end in _dev and _test).
ARTEPOOL_DB=artepool_dev
ARTEPOOL_TEST_DB=artepool_test

# Passwords for the ARTÉPOOL database roles (development only).
ARTEPOOL_MIGRATOR_PASSWORD=change-me-migrator
ARTEPOOL_API_PASSWORD=change-me-api
ARTEPOOL_BACKUP_PASSWORD=change-me-backup
ARTEPOOL_MAINT_PASSWORD=change-me-maint

# Master key that encrypts the owner's 2-step secret. Created by `pnpm dev:secrets`.
# Default: .secrets/master.key in the repository (ignored by Git).
# ARTEPOOL_MASTER_KEY_FILE=

# Backups (decision 0086). Defaults: .backups and .secrets/backup/google-drive.sealed in the repository.
# ARTEPOOL_BACKUP_DIR=
# ARTEPOOL_DRIVE_CREDENTIALS_FILE=
# The app's registration at Google (decision 0095), set by the installer; the same for every
# installation. "Desktop app" client (choose the account) and "TVs and limited input" client (code).
# ARTEPOOL_GOOGLE_CLIENT_ID=
# ARTEPOOL_GOOGLE_CLIENT_SECRET=
# ARTEPOOL_GOOGLE_DEVICE_CLIENT_ID=
# ARTEPOOL_GOOGLE_DEVICE_CLIENT_SECRET=
# Folder with pg_dump / pg_restore when they are not on the PATH (Windows: C:\Program Files\PostgreSQL\18\bin).
# ARTEPOOL_PG_BIN=

# Certificates for HTTPS (TLS 1.3 only). Created by `pnpm tls:init`.
# Default: .secrets/tls in the repository (ignored by Git).
# ARTEPOOL_TLS_DIR=

# API server (development). It serves HTTPS only.
SERVER_HOST=127.0.0.1
SERVER_PORT=3100
LOG_LEVEL=info

# A4 PDFs (M4): the pinned browser on the server PC. Empty in development (Playwright's own is used).
# ARTEPOOL_CHROMIUM=
